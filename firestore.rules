rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Core membership check: verify the user profile points to this company
    function isCompanyMember(cid) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid;
    }

    // --- RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Company Data & Sub-collections
    match /companies/{companyId} {
      allow create: if isSignedIn();
      
      // Top-level document access
      // Using 'get' and 'list' explicitly. Owner check uses resource.data to avoid circular get()
      allow get: if isAdmin() || isCompanyMember(companyId) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin(); // Members usually find their company via their user profile, not by listing /companies
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      // Recursive match for all sub-collections (supportMessages, transactions, walletPayments, products, etc.)
      match /{allSub=**} {
        allow read, write: if isAdmin() || isCompanyMember(companyId);
      }
    }

    // Industrial Registries (Internal)
    match /partners/{partnerId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    // Public Marketplaces
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
    }
  }
}