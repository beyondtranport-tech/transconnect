rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        request.auth.token.admin == true
      );
    }

    // Direct check if the user belongs to the company via their profile
    function isCompanyStaff(cid) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid;
    }

    // Direct check if the user is the owner defined on the company doc
    function isCompanyOwner(cid) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(cid)) && get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid;
    }

    function isMember(cid) {
      return isAdmin() || isCompanyStaff(cid) || isCompanyOwner(cid);
    }

    // --- RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Company Data & Sub-collections
    match /companies/{companyId} {
      // Allow individual GET if authorized
      allow get: if isSignedIn() && (
        isMember(companyId)
      );
      
      // Protect the list operation on the companies collection
      allow list: if isAdmin();
      
      // Allow creation during sign-up
      allow create: if isSignedIn();
      
      // Update/Delete restricted to Admin or Owner
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // Explicit rules for all sub-collections
      // This ensures that list/get/write operations within these paths are allowed for members
      match /supportMessages/{msgId} { allow read, write: if isMember(companyId); }
      match /transactions/{txId} { allow read, write: if isMember(companyId); }
      match /walletPayments/{pmId} { allow read, write: if isMember(companyId); }
      match /enquiries/{enqId} { allow read, write: if isMember(companyId); }
      match /quotes/{qId} { allow read, write: if isMember(companyId); }
      match /staff/{stId} { allow read, write: if isMember(companyId); }
      match /payoutRequests/{pId} { allow read, write: if isMember(companyId); }
      match /searchLogs/{logId} { allow read, write: if isMember(companyId); }
      match /tasks/{taskId} { allow read, write: if isMember(companyId); }
      
      match /shops/{sId} { 
        allow read, write: if isMember(companyId); 
        match /products/{pId} { allow read, write: if isMember(companyId); }
        match /agreements/{aId} { allow read, write: if isMember(companyId); }
      }
      
      match /loadBoards/{lbId} {
          allow read, write: if isMember(companyId);
          match /loads/{loadId} { allow read, write: if isMember(companyId); }
      }

      // Catch-all for any other future sub-collections
      match /{allSub=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // Public Collections
    match /partners/{partnerId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow get: if true;
      allow list, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }
  }
}