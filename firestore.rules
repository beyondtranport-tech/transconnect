
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'].hasAny([request.auth.token.email]) ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          cid == request.auth.uid || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // --- RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow write: if isMember(companyId);
      
      match /{allSub=**} {
        allow read, write: if isMember(companyId);
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Collection group matches for global views
    match /{path=**}/loads/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
    }
    
    match /{path=**}/brokerAgreements/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
