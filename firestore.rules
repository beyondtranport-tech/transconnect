rules_version = '2';

// Security Rules Version: 1.0.5 - Unified Lead/Partner Activity
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // --- 1. GLOBAL ADMIN BYPASS ---
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. PARTNER & LEAD CRM ---
    match /partners/{partnerId} {
      allow read, write: if isAdmin();
      match /communications/{docId} { allow read, write: if isAdmin(); }
      match /tasks/{docId} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      // Allow activity timeline for leads
      match /communications/{docId} { allow read, write: if isAdmin(); }
      match /tasks/{docId} { allow read, write: if isAdmin(); }
    }

    // --- 3. COMPANY & MEMBER DATA ---
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 4. USER-SPECIFIC RULES (FOR NON-ADMINS) ---
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; 
      
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /companies/{companyId} {
      allow create: if request.auth != null; 
      allow get, update: if request.auth != null && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );

      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth != null && (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );
      }
    }
    
    // --- 5. PUBLIC & GLOBAL COLLECTIONS ---
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if request.auth != null;
    }
  }
}