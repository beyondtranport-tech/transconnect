rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    // Explicit check for membership that supports 'list' operations correctly.
    // We use a deterministic path lookup to the user's own profile.
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          cid == request.auth.uid || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // Helper to check ownership of a company document directly.
    // This is more "atomic" and list-friendly for subcollection queries.
    function isParentOwner(cid) {
      return isAdmin() || (
        isSignedIn() && (
          cid == request.auth.uid ||
          get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid
        )
      );
    }

    // --- COLLECTION GROUP RULES ---
    // Collection group rules are primarily for administrative oversight.
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/quotes/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/facilities/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/loads/{id} { allow read, write: if isAdmin(); }

    // --- STANDARD PATH RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // SUBCOLLECTION RULES: Explicitly authorized using Parent Owner check for list stability.
      match /supportMessages/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /transactions/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /walletPayments/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /enquiries/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /payoutRequests/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /searchLogs/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /quotes/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /tasks/{id} { allow get, list, write: if isParentOwner(companyId); }
      match /facilities/{id} { allow get, list: if isParentOwner(companyId); allow write: if isAdmin(); }

      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isParentOwner(companyId);
        match /products/{prodId} { allow read: if true; allow write: if isParentOwner(companyId); }
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    
    match /platformTransactions/{id} {
      allow read, write: if isAdmin();
    }
  }
}

// Global Definitive Rule Sync Token: 2026-03-17T11:00:00Z