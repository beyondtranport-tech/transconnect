rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. PUBLIC HANDSHAKE RULES (CRITICAL: MUST BE TOP) ---
    
    match /partners/{partnerId} {
      // Authorized Public Handshake: Allow single doc retrieval for opt-in links
      allow get: if true; 
      allow list: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
        request.auth.token.get('admin', false) == true
      );
      match /{allSub=**} { 
        allow read, write: if request.auth != null && (
          request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
          request.auth.token.get('admin', false) == true
        ); 
      }
    }

    match /leads/{leadId} {
      // Authorized Public Handshake: Allow single doc retrieval for opt-in links
      allow get: if true; 
      allow list: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
        request.auth.token.get('admin', false) == true
      );
      match /{allSub=**} { 
        allow read, write: if request.auth != null && (
          request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
          request.auth.token.get('admin', false) == true
        ); 
      }
    }

    // --- 2. CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['0Y3IhZffEPNlMAIhURPnzRgNokL2', 'ylVC4F2FIYV8o9jjq13wCYiAyyM2'] ||
        request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
        (request.auth.token.get('admin', false) == true)
      );
    }

    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid) ||
          (exists(/databases/$(database)/documents/companies/$(cid)) && 
           get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid)
        )
      );
    }

    // --- 3. PUBLIC / CONFIGURATION RULES ---

    match /configuration/{configId} {
      allow get, list: if true;
    }
    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    match /shops/{shopId} { 
      allow read: if true; 
      match /products/{prodId} { allow read: if true; }
      match /agreements/{agId} { allow read: if true; }
    }
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    // --- 4. ADMIN OVERRIDE ---
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 5. STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (isMember(companyId) || (exists(/databases/$(database)/documents/companies/$(companyId)) && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)) && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
      
      match /supportMessages/{id} { allow read, write, list: if isMember(companyId); }
      match /transactions/{id} { allow read, list: if isMember(companyId); }
      match /walletPayments/{id} { allow read, write, list: if isMember(companyId); }
      match /enquiries/{id} { allow read, write, list: if isMember(companyId); }
      match /quotes/{id} { allow read, write, list: if isMember(companyId); }
      match /tasks/{id} { allow read, write, list: if isMember(companyId); }
      match /payoutRequests/{id} { allow read, write, list: if isMember(companyId); }
      match /searchLogs/{id} { allow read, write, list: if isMember(companyId); }
      match /facilities/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      match /staff/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      match /brokerAgreements/{id} { allow read, write, list: if isMember(companyId); }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMember(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMember(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId); }
      }

      match /vehicleListings/{id} {
          allow read: if true;
          allow write: if isMember(companyId);
      }
      
      match /loadBoard/{allBoard=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // --- 6. COLLECTION GROUP RULES ---
    match /{path=**}/loads/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /{path=**}/adCampaigns/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
  }
}
