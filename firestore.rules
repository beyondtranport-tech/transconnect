rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/roles_assigned_admin/$(request.auth.uid))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyOwner(companyId) {
        let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
        return companyDoc != null && (companyDoc.data.ownerId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId);
    }

    // --- Admin-Only Management Collections (Prioritized) ---
    
    match /partners/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /leads/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    
    match /platformStaff/{allPaths=**} {
        allow read, write: if isAdmin();
    }

    match /lendingAssets/{allPaths=**} {
        allow read, write: if isAdmin();
    }
    match /lendingClients/{allPaths=**} {
        allow read, write: if isAdmin();
    }
    match /lendingPartners/{allPaths=**} {
        allow read, write: if isAdmin();
    }

    match /reconciliations/{allPaths=**} {
        allow read, write: if isAdmin();
    }

    match /platformTransactions/{allPaths=**} {
        allow read, write: if isAdmin();
    }
    
    match /auditLogs/{allPaths=**} {
        allow read, write: if isAdmin();
    }
    
    match /permissions/{allPaths=**} {
        allow read, write: if isAdmin();
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn(); 
      allow list: if isAdmin();
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Company Profiles ---
    match /companies/{companyId} {
      allow create: if isSignedIn(); 
      allow get, update: if isAdmin() || isCompanyOwner(companyId);
      allow list: if isAdmin();

      match /{subcollection}/{docId=**} {
        allow read, write: if isAdmin() || isCompanyOwner(companyId);
      }
    }
    
    // --- Public & Global Collections ---

    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
      allow read: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }
  }
}