rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        request.auth.token.admin == true
      );
    }

    // Explicit check to see if user is a member of the company.
    // Query-level security requires get() or direct UID mapping.
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && cid != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // --- RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Company Data Hierarchy
    match /companies/{companyId} {
      // Members can see their own company profile
      allow get: if isMember(companyId);
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // Explicitly permitting list and write for sub-collections to members.
      // Using 'read' instead of 'get'/'list' separately for robustness.
      match /{allSub=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // Public Registries & Discovery
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    // Public Market Access
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    // Configuration Data
    match /configuration/{configId} {
      allow get, list: if true;
    }

    // Community Contributions
    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
