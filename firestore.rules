rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. ABSOLUTE ADMIN BYPASS (CRITICAL) ---
    // This rule must be at the very top. It grants full recursive access to specific emails.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com'
      );
    }

    // --- 2. USER-SPECIFIC RULES (FOR NON-ADMINS) ---
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; 
      
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /companies/{companyId} {
      allow create: if request.auth != null; 
      allow get, update: if request.auth != null && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );

      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth != null && (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );
      }
    }
    
    // --- 3. PUBLIC & GLOBAL COLLECTIONS ---
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if request.auth != null;
    }
  }
}