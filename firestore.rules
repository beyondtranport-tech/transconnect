rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- ATOMIC AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'].hasAny([request.auth.token.email]) ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    // Engineering Note: Rules refactored to use Direct Path Matching for atomicity.
    // get() calls inside list operations are limited to ensure query efficiency.
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          cid == request.auth.uid || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // --- RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      match /{allSub=**} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow write: if isMember(companyId);
      
      // Explicit Sub-collection matching for atomic 'list' operations
      match /supportMessages/{id} { allow read, write: if isMember(companyId); }
      match /transactions/{id} { allow read, write: if isMember(companyId); }
      match /walletPayments/{id} { allow read, write: if isMember(companyId); }
      match /enquiries/{id} { allow read, write: if isMember(companyId); }
      match /quotes/{id} { allow read, write: if isMember(companyId); }
      match /tasks/{id} { allow read, write: if isMember(companyId); }
      match /payoutRequests/{id} { allow read, write: if isMember(companyId); }
      match /facilities/{id} { allow read: if isMember(companyId); allow write: if isAdmin(); }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMember(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMember(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId); }
      }
      
      match /loadBoard/{allBoard=**} {
        allow read, write: if isMember(companyId);
      }

      match /{allSub=**} {
        allow read, write: if isMember(companyId);
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    // Collection group matches for global views (Admins only)
    match /{path=**}/loads/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
    }
    
    match /{path=**}/brokerAgreements/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.brokerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId);
    }

    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
