rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // --- 1. ABSOLUTE ADMIN BYPASS (HIGHEST PRIORITY) ---
    // Explicitly allow list/query operations on root-level CRM collections.
    // These must be matched explicitly for the query engine to verify permissions correctly.
    match /platformCommunications/{docId=**} {
      allow read, write: if isAdmin();
    }
    
    match /platformTasks/{docId=**} {
      allow read, write: if isAdmin();
    }

    // Global recursive bypass for everything else
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. USER-SPECIFIC RULES (FOR NON-ADMINS) ---
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; 
      
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /companies/{companyId} {
      allow create: if request.auth != null; 
      allow get, update: if request.auth != null && (
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );

      match /{subcollection}/{docId=**} {
        allow read, write: if request.auth != null && (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );
      }
    }
    
    // --- 3. PUBLIC & GLOBAL COLLECTIONS ---
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if request.auth != null;
    }
  }
}