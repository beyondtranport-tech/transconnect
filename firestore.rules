rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let isSuperAdminByEmail = isSignedIn() && (request.auth.token.email == 'mkoton100@gmail.com' || request.auth.token.email == 'beyondtransport@gmail.com');
      let hasAdminClaim = isSignedIn() && request.auth.token.admin == true;
      let isAssignedAdmin = isSignedIn() && exists(/databases/$(database)/documents/roles_assigned_admin/$(request.auth.uid));
      return isSuperAdminByEmail || hasAdminClaim || isAssignedAdmin;
    }
    
    function isCompanyOwner(companyId) {
        let companyDoc = get(/databases/$(database)/documents/companies/$(companyId)).data;
        return companyDoc.ownerId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn(); 
      allow list: if isAdmin();
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // --- Company Profiles ---
    match /companies/{companyId} {
      allow create: if isSignedIn(); 
      allow get, update: if isAdmin() || isCompanyOwner(companyId);
      allow list: if isAdmin();

      match /{subcollection}/{docId=**} {
        allow read, write: if isAdmin() || isCompanyOwner(companyId);
      }
    }
    
    // --- Collection Group Queries for Admin Backend ---
    match /{path=**}/staff/{staffId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/walletPayments/{paymentId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/transactions/{transactionId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/quotes/{quoteId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/enquiries/{enquiryId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/shops/{shopId} {
      allow get, list: if isAdmin();
    }
     match /{path=**}/agreements/{agreementId} {
      allow get, list: if isAdmin();
    }
    match /{path=**}/auditLogs/{logId} {
      allow get, list: if isAdmin();
    }

    // --- Public & Global Collections ---

    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
      allow read: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /reconciliations/{reconciliationId} {
        allow read, write: if isAdmin();
    }

    match /platformTransactions/{transactionId} {
        allow read, write: if isAdmin();
    }
    
    match /auditLogs/{logId} {
        allow read, write: if isAdmin();
    }

    match /permissions/{path=**} {
        allow read, write: if isAdmin();
    }

    match /leads/{leadId=**} {
      allow read, write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read, write: if isAdmin();
      match /{allPaths=**} {
        allow read, write: if isAdmin();
      }
    }
    
    match /lendingAssets/{assetId} {
        allow read, write: if isAdmin();
    }
    match /lendingClients/{clientId}/{document=**} {
        allow read, write: if isAdmin();
    }
    match /lendingPartners/{partnerId}/{document=**} {
        allow read, write: if isAdmin();
    }
  }
}
