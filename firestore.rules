rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'].hasAny([request.auth.token.email]) ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    /**
     * IS MEMBER / OWNER CHECK
     * High-speed verification for company-level data.
     * Checks both the user profile mapping AND direct ownership on the company record.
     */
    function isMember(cid) {
      let uid = request.auth.uid;
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          // Path 1: User's profile document explicitly links to this company
          get(/databases/$(database)/documents/users/$(uid)).data.companyId == cid ||
          // Path 2: The company document explicitly lists this user as the owner
          get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == uid
        )
      );
    }

    function isSaleParticipant(sale) {
        let userCid = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
        return sale != null && (sale.buyerId == userCid || sale.sellerId == userCid);
    }

    // --- STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)) && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
      
      // Sub-collection matches using explicit isMember authorization
      match /supportMessages/{id} { allow read, write, list: if isMember(companyId); }
      match /transactions/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      match /walletPayments/{id} { allow read, write, list: if isMember(companyId); }
      match /enquiries/{id} { allow read, write, list: if isMember(companyId); }
      match /quotes/{id} { allow read, write, list: if isMember(companyId); }
      match /tasks/{id} { allow read, write, list: if isMember(companyId); }
      match /payoutRequests/{id} { allow read, write, list: if isMember(companyId); }
      match /searchLogs/{id} { allow read, write, list: if isMember(companyId); }
      match /facilities/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      match /staff/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMember(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMember(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId); }
      }

      match /vehicleListings/{id} {
          allow read: if true;
          allow write: if isMember(companyId);
      }
      
      match /loadBoard/{allBoard=**} {
        allow read, write: if isMember(companyId);
      }
    }

    match /sales/{saleId} {
      allow read: if isSignedIn() && (isAdmin() || isSaleParticipant(resource.data));
      allow write: if isAdmin() || (isSignedIn() && (
        (!exists(/databases/$(database)/documents/sales/$(saleId)) && request.resource.data.buyerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId) ||
        isSaleParticipant(resource.data)
      ));
      
      match /messages/{id} {
        allow read, write: if isSignedIn() && (isAdmin() || isSaleParticipant(get(/databases/$(database)/documents/sales/$(saleId)).data));
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    
    match /platformTransactions/{id} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION GROUP RULES ---
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/quotes/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/facilities/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/loads/{id} { allow read, write: if isAdmin(); }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}