rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Helper for sub-collection access. 
    // Breaks recursion by using the user profile first and being called from sub-paths.
    function isMember(cid) {
      return isAdmin() || 
             (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid) ||
             (isSignedIn() && get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid);
    }

    // --- RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      // Allow user to read their own profile, and allow rules engine to 'get' any profile via UID for membership checks.
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Company Data & Sub-collections
    match /companies/{companyId} {
      // Direct document access - Break recursion by avoiding isMember() call for the company doc itself.
      allow get: if isAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      ));
      
      allow list: if isAdmin();
      
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // Explicitly handle all sub-collections (Support Chat, Wallet, etc.)
      match /{allSub=**} {
        allow read, write: if isMember(companyId);
      }
    }

    // Industrial Registries (Internal)
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    // Public Marketplaces
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
    }
  }
}