rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Direct check: Does the company document exist and does the user own it?
    function isCompanyOwner(cid) {
      return isSignedIn() && get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid;
    }

    // Indirect check: Does the user's profile document link them to this company?
    function isCompanyStaff(cid) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid;
    }

    function isMember(cid) {
      return isAdmin() || isCompanyOwner(cid) || isCompanyStaff(cid);
    }

    // --- RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Company Data & Sub-collections
    match /companies/{companyId} {
      // Allow read/write for owners and admins
      allow read, write: if isAdmin() || (isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid));
      // Allow members (staff/owners) to get the company doc
      allow get: if isMember(companyId);
      
      // Explicitly handle all sub-collections (Support Chat, Wallet, etc.)
      match /{allSub=**} {
        allow read, write: if isAdmin() || isMember(companyId);
      }
    }

    // Industrial Registries (Internal)
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    // Public Marketplaces
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
    }
  }
}