rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'].hasAny([request.auth.token.email]) ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    // Deterministic membership check optimized for query performance.
    // Verifies identity against the user's own profile doc.
    function isMemberOf(cid) {
      return isAdmin() || (
        isSignedIn() && (
          cid == request.auth.uid || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // --- STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isMemberOf(companyId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
      
      // SUBCOLLECTION RULES: Using isMemberOf for atomic query-filtering support.
      match /supportMessages/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /transactions/{id} { allow get, list: if isMemberOf(companyId); allow write: if isAdmin(); }
      match /walletPayments/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /enquiries/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /payoutRequests/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /searchLogs/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /quotes/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /tasks/{id} { allow get, list, write: if isMemberOf(companyId); }
      match /facilities/{id} { allow get, list: if isMemberOf(companyId); allow write: if isAdmin(); }
      match /staff/{id} { allow get, list: if isMemberOf(companyId); allow write: if isAdmin(); }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMemberOf(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMemberOf(companyId); }
        match /agreements/{agId} { allow read, write: if isMemberOf(companyId); }
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    
    match /platformTransactions/{id} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION GROUP RULES ---
    // Explicitly matched for global administrative oversight and cross-company queries.
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/quotes/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/facilities/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/loads/{id} { allow read, write: if isAdmin(); }

    // Global Admin Override (Final Safety)
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}

