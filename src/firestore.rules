rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        request.auth.uid == 'ylVC4F2FIYV8o9jjq13wCYiAyyM2' ||
        request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
        (request.auth.token.admin == true)
      );
    }

    /**
     * IS MEMBER / OWNER CHECK
     * High-speed resilient verification for mission-critical paths.
     */
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          // Path 1: User profile link (Primary)
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid) ||
          // Path 2: Direct ownership on target record (Fallback)
          (exists(/databases/$(database)/documents/companies/$(cid)) && 
           get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid)
        )
      );
    }

    function isSaleParticipant(sale) {
        return isSignedIn() && (
            isAdmin() || 
            sale.buyerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId || 
            sale.sellerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        );
    }

    // --- PUBLIC / CONFIGURATION RULES ---

    match /configuration/{configId} {
      allow get, list: if true;
    }
    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    match /shops/{shopId} { 
      allow read: if true; 
      match /products/{prodId} { allow read: if true; }
    }
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    // --- STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (isMember(companyId) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      match /supportMessages/{id} { allow read, write, list: if isMember(companyId); }
      match /transactions/{id} { allow read, list: if isMember(companyId); }
      match /walletPayments/{id} { allow read, write, list: if isMember(companyId); }
      match /enquiries/{id} { allow read, write, list: if isMember(companyId); }
      match /quotes/{id} { allow read, write, list: if isMember(companyId); }
      match /tasks/{id} { allow read, write, list: if isMember(companyId); }
      match /payoutRequests/{id} { allow read, write, list: if isMember(companyId); }
      match /searchLogs/{id} { allow read, write, list: if isMember(companyId); }
      match /facilities/{id} { allow read, list: if isMember(companyId); allow write: if isAdmin(); }
      match /staff/{id} { allow read, write, list: if isMember(companyId); }
      match /brokerAgreements/{id} { allow read, write, list: if isMember(companyId); }
      match /assets/{id} { allow read, write, list: if isMember(companyId); }
      match /vehicleListings/{id} { allow read, write, list: if isMember(companyId); }
      
      match /shops/{shopId} { 
        allow write: if isMember(companyId); 
        match /products/{prodId} { allow write: if isMember(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId); }
      }

      match /loads/{id} {
        allow read, write, list: if isMember(companyId);
      }

      match /warehouses/{id} {
        allow read, write, list: if isMember(companyId);
      }
    }

    match /sales/{saleId} {
      allow read: if isSignedIn() && (isAdmin() || isSaleParticipant(resource.data));
      allow write: if isAdmin() || (isSignedIn() && (
        (!exists(/databases/$(database)/documents/sales/$(saleId)) && request.resource.data.buyerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId) ||
        isSaleParticipant(resource.data)
      ));
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    // --- COLLECTION GROUP RULES ---
    match /{path=**}/loads/{id} { allow read: if isSignedIn(); allow write: if isAdmin() || isMember(resource.data.companyId); }
    match /{path=**}/shops/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read: if true; allow write: if isAdmin() || isMember(resource.data.companyId); }
    match /{path=**}/assets/{id} { allow read: if true; allow write: if isAdmin() || isMember(resource.data.companyId); }
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin() || isMember(resource.data.companyId); }
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/brokerAgreements/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}