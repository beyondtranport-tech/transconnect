rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // BREAKS RECURSION: Check if the user document points to this company
    function userLinkedToCompany(cid) {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid;
    }

    // --- RULES ---

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; 
      
      match /{allSub=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow create: if request.auth != null;
      
      // Use resource.data to avoid self-referencing get() calls
      allow get, list, update: if isAdmin() || (
        request.auth != null && (
          (exists(resource) && resource.data.ownerId == request.auth.uid) ||
          userLinkedToCompany(companyId)
        )
      );

      // Explicitly authorize sub-collections for members
      match /{allSub=**} {
        allow read, write: if isAdmin() || (
          request.auth != null && (
            get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid ||
            userLinkedToCompany(companyId)
          )
        );
      }
    }

    match /partners/{partnerId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if request.auth != null;
    }
  }
}