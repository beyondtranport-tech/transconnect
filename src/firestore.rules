
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- CORE AUTHORIZATION HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ['0Y3IhZffEPNlMAIhURPnzRgNokL2', 'ylVC4F2FIYV8o9jjq13wCYiAyyM2'] ||
        request.auth.token.email in ['mkoton100@gmail.com', 'beyondtransport@gmail.com', 'michael@logisticsflow.co.za'] ||
        (request.auth.token.get('admin', false) == true)
      );
    }

    // --- PRIORITY MATCHERS ---

    match /engagementPings/{pingId} {
      allow list, get: if isSignedIn();
      allow write: if isAdmin();
    }

    match /platformTasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION RULES ---

    match /partners/{partnerId} {
      allow get: if true; 
      allow list: if isSignedIn();
      allow write: if isAdmin();
      
      match /vouches/{vouchId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); 
      }
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
      }
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow get: if true; 
      allow list: if isSignedIn();
      allow write: if isAdmin();
      
      match /vouches/{vouchId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); 
      }
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /configuration/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /memberships/{membershipId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /shops/{shopId} { 
      allow read: if true; 
      match /products/{prodId} { allow read: if true; }
      match /agreements/{agId} { allow read: if true; }
    }

    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    // --- STANDARD PATH RULES ---

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)) && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
      
      match /supportMessages/{id} { allow read, write, list: if request.auth != null; }
      match /transactions/{id} { allow read, list: if request.auth != null; }
      match /walletPayments/{id} { allow read, write, list: if request.auth != null; }
      match /enquiries/{id} { allow read, write, list: if request.auth != null; }
      match /quotes/{id} { allow read, write, list: if request.auth != null; }
      match /tasks/{id} { allow read, write, list: if request.auth != null; }
      match /payoutRequests/{id} { allow read, write, list: if request.auth != null; }
      match /searchLogs/{id} { allow read, write, list: if request.auth != null; }
      match /facilities/{id} { allow read, list: if request.auth != null; allow write: if isAdmin(); }
      match /staff/{id} { allow read, list: if request.auth != null; allow write: if isAdmin(); }
      match /brokerAgreements/{id} { allow read, write, list: if request.auth != null; }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if request.auth != null; 
        match /products/{prodId} { allow read: if true; allow write: if request.auth != null; }
        match /agreements/{agId} { allow read, write: if request.auth != null; }
      }

      match /vehicleListings/{id} {
          allow read: if true;
          allow write: if request.auth != null;
      }
    }

    // --- GLOBAL ADMIN OVERRIDE ---
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
