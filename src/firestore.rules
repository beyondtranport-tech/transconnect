rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Simplified for robustness to resolve persistent permission issues
      return isSignedIn() && (
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyOwner(companyId) {
        // Fallback check for non-admin users
        return isSignedIn() && (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );
    }

    // --- 1. GLOBAL ADMIN BYPASS (CRITICAL) ---
    // This must be the first match to ensure admins are never blocked.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. MANAGEMENT COLLECTIONS (EXPLICIT) ---
    match /partners/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /leads/{document=**} {
      allow read, write: if isAdmin();
    }

    // --- 3. USER-SPECIFIC RULES ---
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn(); 
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /companies/{companyId} {
      allow create: if isSignedIn(); 
      allow get, update: if isCompanyOwner(companyId);

      match /{subcollection}/{docId=**} {
        allow read, write: if isCompanyOwner(companyId);
      }
    }
    
    // --- 4. PUBLIC & GLOBAL COLLECTIONS ---
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
    }
  }
}