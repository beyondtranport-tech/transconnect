rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        request.auth.token.admin == true
      );
    }

    // Explicit check for membership that supports 'list' operations correctly.
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
      );
    }

    // --- RULES ---

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      match /supportMessages/{msgId} { allow read, write: if isMember(companyId); }
      match /transactions/{txId} { allow read, write: if isMember(companyId); }
      match /walletPayments/{payId} { allow read, write: if isMember(companyId); }
      match /enquiries/{enqId} { allow read, write: if isMember(companyId); }
      match /quotes/{quoteId} { allow read, write: if isMember(companyId); }
      match /tasks/{taskId} { allow read, write: if isMember(companyId); }
      match /payoutRequests/{pid} { allow read, write: if isMember(companyId); }
      match /searchLogs/{sid} { allow read, write: if isMember(companyId); }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMember(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMember(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId); }
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}