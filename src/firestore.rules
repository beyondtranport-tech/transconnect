
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    // Direct ownership check for a company document
    function isOwnerOfCompany(cid) {
      return isSignedIn() && (
        cid == request.auth.uid ||
        get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid
      );
    }

    // Check if user is a member of the company via their user profile
    function isMemberOfCompany(cid) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
      );
    }

    // --- COLLECTION GROUP RULES ---
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/quotes/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/facilities/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/loads/{id} { allow read, write: if isAdmin(); }

    // --- STANDARD PATH RULES ---

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- COMPANY & SUBCOLLECTION AUTHORIZATION ---
    // Explicitly handle subcollections first to avoid match interference
    
    match /companies/{companyId}/supportMessages/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/transactions/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/walletPayments/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/enquiries/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/quotes/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/tasks/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/payoutRequests/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }
    
    match /companies/{companyId}/searchLogs/{id} {
      allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId);
    }

    match /companies/{companyId} {
      allow get: if isSignedIn() && (isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId));
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      match /facilities/{id} { 
        allow read: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId); 
        allow write: if isAdmin(); 
      }
      match /staff/{id} { 
        allow read: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId); 
        allow write: if isAdmin(); 
      }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId); }
        match /agreements/{agId} { allow read, write: if isAdmin() || isOwnerOfCompany(companyId) || isMemberOfCompany(companyId); }
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    
    match /platformTransactions/{id} {
      allow read, write: if isAdmin();
    }
  }
}
