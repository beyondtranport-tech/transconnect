
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' ||
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.email == 'michael@logisticsflow.co.za' ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true)
      );
    }

    // Direct check if the user is the owner of a company based on parent data
    function isCompanyOwner(cid) {
      return isSignedIn() && (
        cid == request.auth.uid ||
        get(/databases/$(database)/documents/companies/$(cid)).data.ownerId == request.auth.uid
      );
    }

    // Check membership via the user profile document
    function isMember(cid) {
      return isAdmin() || (
        isSignedIn() && 
        cid != null && (
          cid == request.auth.uid || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == cid
        )
      );
    }

    // --- COLLECTION GROUP RULES ---
    // These MUST be defined with the /{path=**} prefix to be valid for group queries.
    match /{path=**}/enquiries/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/supportMessages/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/staff/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/tasks/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/walletPayments/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/quotes/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/searchLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/communications/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/facilities/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/auditLogs/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/shops/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/products/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/reconciliations/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/vehicleListings/{id} { allow read, write: if isAdmin(); }
    match /{path=**}/loads/{id} { allow read, write: if isAdmin(); }

    // --- STANDARD PATH RULES ---

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn(); 
      
      match /{allSub=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /companies/{companyId} {
      // Members can get their own company doc
      allow get: if isMember(companyId) || isCompanyOwner(companyId);
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // Explicit rules for sub-collections to ensure 'list' works for members
      match /supportMessages/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /transactions/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /walletPayments/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /enquiries/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /quotes/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /tasks/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /payoutRequests/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /searchLogs/{id} { 
        allow read, write: if isMember(companyId) || isCompanyOwner(companyId); 
      }
      match /facilities/{id} { 
        allow read: if isMember(companyId) || isCompanyOwner(companyId); 
        allow write: if isAdmin(); 
      }
      match /staff/{id} { 
        allow read: if isMember(companyId) || isCompanyOwner(companyId); 
        allow write: if isAdmin(); 
      }
      
      match /shops/{shopId} { 
        allow read: if true; 
        allow write: if isMember(companyId) || isCompanyOwner(companyId); 
        match /products/{prodId} { allow read: if true; allow write: if isMember(companyId) || isCompanyOwner(companyId); }
        match /agreements/{agId} { allow read, write: if isMember(companyId) || isCompanyOwner(companyId); }
      }
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{allSub=**} { allow read, write: if isAdmin(); }
    }
    
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    
    match /platformTransactions/{id} {
      allow read, write: if isAdmin();
    }
  }
}
