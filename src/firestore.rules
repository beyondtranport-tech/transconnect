rules_version = '2';

// Security Rules Version: 1.0.7 - Member Subcollection Access Fix
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0Y3IhZffEPNlMAIhURPnzRgNokL2' || 
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Helper to check if the user belongs to the company
    function isCompanyMember(companyId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // --- 1. GLOBAL ADMIN BYPASS ---
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. PARTNER & LEAD CRM ---
    match /partners/{partnerId} {
      allow read, write: if isAdmin();
      match /communications/{docId} { allow read, write: if isAdmin(); }
      match /tasks/{docId} { allow read, write: if isAdmin(); }
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
      match /communications/{docId} { allow read, write: if isAdmin(); }
      match /tasks/{docId} { allow read, write: if isAdmin(); }
    }

    // --- 3. COMPANY & MEMBER DATA ---
    match /companies/{companyId} {
      allow create: if request.auth != null;
      allow get, update: if isAdmin() || isCompanyMember(companyId);

      // Explicitly allow members to manage their own subcollections
      // This fix ensures 'list' operations on these paths are permitted for the owner.
      match /supportMessages/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /walletPayments/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /transactions/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /enquiries/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /quotes/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /staff/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /payoutRequests/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /searchLogs/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      match /vehicleListings/{docId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      
      match /shops/{shopId} { 
        allow read, write: if isAdmin() || isCompanyMember(companyId); 
        match /products/{prodId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
        match /agreements/{agId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      }
      match /loadBoards/{boardId} {
        allow read, write: if isAdmin() || isCompanyMember(companyId);
        match /loads/{loadId} { allow read, write: if isAdmin() || isCompanyMember(companyId); }
      }
      
      // Fallback for any other subcollections
      match /{subcollection}/{docId=**} {
        allow read, write: if isAdmin() || isCompanyMember(companyId);
      }
    }

    // --- 4. USER-SPECIFIC RULES ---
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null; 
      
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // --- 5. PUBLIC & GLOBAL COLLECTIONS ---
    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if request.auth != null;
    }
  }
}