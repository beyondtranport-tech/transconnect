rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mkoton100@gmail.com' || 
        request.auth.token.email == 'beyondtransport@gmail.com' ||
        (request.auth.token.keys().contains('admin') && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/roles_assigned_admin/$(request.auth.uid))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyOwner(companyId) {
        let companyDoc = get(/databases/$(database)/documents/companies/$(companyId));
        return companyDoc != null && (companyDoc.data.ownerId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId);
    }

    // --- 1. GLOBAL ADMIN BYPASS (CRITICAL) ---
    // This ensures super admins have full recursive access to everything.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // --- 2. USER-SPECIFIC RULES (For non-admin users) ---

    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn(); 
      
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /companies/{companyId} {
      allow create: if isSignedIn(); 
      allow get, update: if isCompanyOwner(companyId);

      match /{subcollection}/{docId=**} {
        allow read, write: if isCompanyOwner(companyId);
      }
    }
    
    // --- 3. PUBLIC & GLOBAL COLLECTIONS ---

    match /shops/{shopId}/{path=**} {
      allow get, list: if true;
    }
    
    match /visitors/{visitorId} {
      allow write: if true;
    }

    match /memberships/{membershipId} {
      allow get, list: if true;
    }
    
    match /configuration/{configId} {
      allow get, list: if true;
    }

    match /contributions/{contributionId} {
      allow create: if isSignedIn();
    }
  }
}
