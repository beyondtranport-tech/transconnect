{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a single user account in Firebase Authentication.",
      "properties": {
        "id": { "type": "string", "description": "The user's Firebase Auth UID." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "companyId": { "type": ["string", "null"], "description": "The ID of the company this user belongs to in the /companies collection. Null for partners." },
        "role": { "type": "string", "enum": ["owner", "staff", "partner"], "description": "The user's role in the system." },
        "passwordChangeRequired": { "type": "boolean", "description": "If true, the user must change their password on next login." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Partner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partner",
      "type": "object",
      "description": "Represents a strategic partner, ISA, Investor, Developer, Supplier, Finance Co or Transporter.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "mobile": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "contacted", "new", "qualified", "invited", "registered"] },
        "type": { "type": "string", "enum": ["partner", "isa", "investor", "developer", "supplier", "transporter", "finance"] },
        "minedServiceWording": { "type": "string", "description": "Full technical profile and about text scraped from the website hero sections." },
        "industrialTags": { "type": "array", "items": { "type": "string" }, "description": "ML-extracted keywords for search indexing." },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "assigneeId": { "type": "string", "description": "UID of the allocated platform staff member." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["firstName", "lastName", "email", "type"]
    },
    "Load": {
      "title": "Load Listing",
      "type": "object",
      "description": "A specific freight load handled through the fulfillment lifecycle.",
      "properties": {
        "id": { "type": "string" },
        "brokerId": { "type": "string" },
        "brokerName": { "type": "string" },
        "takerId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "assigned", "delivered", "completed", "cancelled"] },
        "instructionNumber": { "type": "string" },
        "podUrl": { "type": "string", "description": "Uploaded Proof of Delivery URL." },
        "completionDate": { "type": "object" },
        "haulierPayout": { "type": "number" },
        "brokerEarn": { "type": "number" },
        "platformFee": { "type": "number" },
        "collectionDetails": { "type": "string" },
        "deliveryDetails": { "type": "string" },
        "demurrageConditions": { "type": "string" }
      },
      "required": ["id", "status"]
    },
    "BrokerAgreement": {
      "title": "Broker Authorization",
      "type": "object",
      "description": "Legal right to subcontract freight from a specific Debtor.",
      "properties": {
        "id": { "type": "string" },
        "brokerId": { "type": "string" },
        "providerName": { "type": "string" },
        "subcontractingClause": { "type": "string" },
        "primaryContractUrl": { "type": "string" },
        "subcontractorAgreementUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] }
      },
      "required": ["brokerId", "providerName", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" }, "description": "User profiles." }
      },
      {
        "path": "/partners/{partnerId}",
        "definition": { "entityName": "Partner", "schema": { "$ref": "#/entities/Partner" }, "description": "Consolidated industrial registry." }
      },
      {
        "path": "/companies/{companyId}/loadBoard/loads/{loadId}",
        "definition": { "entityName": "Load", "schema": { "$ref": "#/entities/Load" }, "description": "Execution and fulfillment registry." }
      },
      {
        "path": "/companies/{companyId}/brokerAgreements/{agreementId}",
        "definition": { "entityName": "BrokerAgreement", "schema": { "$ref": "#/entities/BrokerAgreement" }, "description": "Subcontracting rights registry." }
      }
    ]
  }
}