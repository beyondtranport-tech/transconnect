
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a single user account in Firebase Authentication.",
      "properties": {
        "id": { "type": "string", "description": "The user's Firebase Auth UID." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "companyId": { "type": ["string", "null"], "description": "The ID of the company this user belongs to in the /companies collection. Null for partners." },
        "role": { "type": "string", "enum": ["owner", "staff", "partner"], "description": "The user's role in the system." },
        "passwordChangeRequired": { "type": "boolean", "description": "If true, the user must change their password on next login." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Partner": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partner",
      "type": "object",
      "description": "Represents a strategic partner, ISA, Investor, Developer, Supplier, Finance Co or Transporter.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "mobile": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "contacted", "new", "qualified", "invited", "registered"] },
        "type": { "type": "string", "enum": ["partner", "isa", "investor", "developer", "supplier", "transporter", "finance", "distributor"] },
        "minedServiceWording": { "type": "string", "description": "First 300 words of technical content scraped from the sitemap sub-pages." },
        "industrialTags": { "type": "array", "items": { "type": "string" }, "description": "ML-extracted keywords for search indexing." },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "marketingManager": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "mobile": { "type": "string" }
          }
        },
        "ceo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string" },
            "mobile": { "type": "string" }
          }
        },
        "assigneeId": { "type": "string", "description": "UID of the allocated platform staff member." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["firstName", "lastName", "email", "type"]
    },
    "AdCampaign": {
      "title": "Industrial Ad Campaign",
      "type": "object",
      "description": "A paid promotion increasing visibility in specific malls.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "targetAudience": { "type": "string", "enum": ["transporters", "suppliers", "finance", "all"] },
        "creativeUrl": { "type": "string" },
        "budget": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "pending_approval", "active", "completed", "rejected"] },
        "metrics": {
          "type": "object",
          "properties": {
            "impressions": { "type": "number" },
            "clicks": { "type": "number" }
          }
        },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" }, "description": "User profiles." }
      },
      {
        "path": "/partners/{partnerId}",
        "definition": { "entityName": "Partner", "schema": { "$ref": "#/entities/Partner" }, "description": "Consolidated industrial registry." }
      },
      {
        "path": "/companies/{companyId}/adCampaigns/{adId}",
        "definition": { "entityName": "AdCampaign", "schema": { "$ref": "#/entities/AdCampaign" }, "description": "Member-managed ad campaigns." }
      }
    ]
  }
}
