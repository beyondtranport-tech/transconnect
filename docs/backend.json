
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a single user account in Firebase Authentication.",
      "properties": {
        "id": { "type": "string", "description": "The user's Firebase Auth UID." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "companyId": { "type": ["string", "null"], "description": "The ID of the company this user belongs to in the /companies collection." },
        "role": { "type": "string", "enum": ["owner", "staff", "partner"], "description": "The user's role in the system." },
        "declaredPosition": { "type": "string", "description": "The role selected by the user during onboarding (e.g., transporter, vendor)." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "Shop": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Shop",
      "type": "object",
      "description": "Represents a member's commercial profile (Shop or Service Profile).",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "ownerId": { "type": "string" },
        "shopName": { "type": "string" },
        "shopType": { "type": "string", "enum": ["vendor", "transporter"] },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_review", "approved", "rejected"] },
        "homeHeading": { "type": "string", "description": "Custom headline for the profile home page." },
        "homeSubheading": { "type": "string" },
        "aboutText": { "type": "string", "description": "Detailed company bio." },
        "termsText": { "type": "string", "description": "Legal terms and conditions for the shop." },
        "privacyText": { "type": "string", "description": "Privacy policy for the shop." },
        "showcaseFleetIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of verified fleet items to display." },
        "platformCommission": { "type": "number", "description": "The agreed platform commission rate." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "companyId", "shopName", "shopType", "status"]
    },
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Represents a member's business entity on the TransConnect platform.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "companyName": { "type": "string" },
        "shopId": { "type": "string" },
        "shopType": { "type": "string", "enum": ["vendor", "transporter"] },
        "membershipId": { "type": "string" },
        "rewardPoints": { "type": "number" },
        "walletBalance": { "type": "number" },
        "availableBalance": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "ownerId", "companyName", "membershipId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/companies/{companyId}",
        "definition": {
          "entityName": "Company",
          "schema": { "$ref": "#/entities/Company" },
          "description": "Member company records."
        }
      },
      {
        "path": "/companies/{companyId}/shops/{shopId}",
        "definition": {
          "entityName": "Shop",
          "schema": { "$ref": "#/entities/Shop" },
          "description": "Member's commercial profile."
        }
      }
    ],
    "reasoning": "Standardized the Shop entity to include detailed content and legal fields for role-aware commercial profiles."
  }
}
