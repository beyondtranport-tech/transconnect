
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a single user account in Firebase Authentication.",
      "properties": {
        "id": { "type": "string", "description": "The user's Firebase Auth UID." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "companyId": { "type": ["string", "null"], "description": "The ID of the company this user belongs to in the /companies collection. Null for partners." },
        "role": { "type": "string", "enum": ["owner", "staff", "partner"], "description": "The user's role in the system." },
        "permissions": { "type": "array", "items": { "type": "string" }, "description": "List of 'action:resource' permission strings." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "firstName", "lastName", "email", "role"]
    },
    "BrokerAgreement": {
      "title": "Broker Agreement",
      "type": "object",
      "description": "Formal appointment of a member as a subcontractor for a load provider.",
      "properties": {
        "id": { "type": "string" },
        "brokerId": { "type": "string", "description": "Company ID of the member acting as broker." },
        "providerId": { "type": "string", "description": "ID of the company providing the work (from registry)." },
        "providerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "agreementUrl": { "type": "string", "description": "URL to the signed appointment letter." },
        "commissionRate": { "type": "number", "description": "Agreed percentage split for the broker." },
        "createdAt": { "type": "object" }
      },
      "required": ["brokerId", "providerId", "status"]
    },
    "Load": {
      "title": "Load Listing",
      "type": "object",
      "description": "A specific freight load posted on the board.",
      "properties": {
        "id": { "type": "string" },
        "brokerId": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "cargoType": { "type": "string" },
        "requiredEquipment": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number" },
        "totalValue": { "type": "number", "description": "What the provider pays." },
        "brokerFee": { "type": "number" },
        "platformFee": { "type": "number" },
        "haulierPayout": { "type": "number", "description": "What the haulier receives." },
        "status": { "type": "string", "enum": ["active", "negotiating", "assigned", "completed", "cancelled"] },
        "takerId": { "type": "string", "description": "Company ID of the haulier who accepted." },
        "driverId": { "type": "string", "description": "ID of the allocated driver." },
        "vehicleId": { "type": "string", "description": "ID of the allocated fleet asset." },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["brokerId", "origin", "destination", "cargoType", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" }, "description": "User profiles." }
      },
      {
        "path": "/companies/{companyId}/brokerAgreements/{agreementId}",
        "definition": { "entityName": "BrokerAgreement", "schema": { "$ref": "#/entities/BrokerAgreement" }, "description": "Member's subcontractor appointments." }
      },
      {
        "path": "/companies/{companyId}/loadBoard/loads/{loadId}",
        "definition": { "entityName": "Load", "schema": { "$ref": "#/entities/Load" }, "description": "Private load registry." }
      }
    ]
  }
}
